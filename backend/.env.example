DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobassistant
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Single-user login for the job tracker and portfolio admin panel.
ADMIN_USERNAME=zachlieberman
ADMIN_PASSWORD=change_me

# Optional: signs login tokens independently of ADMIN_PASSWORD, so rotating
# one doesn't force-invalidate the other's sessions. Falls back to
# ADMIN_PASSWORD if unset.
TOKEN_SIGNING_KEY=

# Comma-separated list of allowed frontend origins (CORS).
# In production, set this to your Vercel URL(s), e.g.:
# CORS_ORIGINS=https://job-assistant.vercel.app,https://job-assistant-git-main-yourname.vercel.app
CORS_ORIGINS=http://localhost:5173

# Your Vercel team slug (from a preview URL like
# job-assistant-<hash>-<team-slug>.vercel.app). Every preview deployment
# under this team is allowed via CORS automatically, without needing to add
# CORS_ORIGINS entries by hand after every push.
VERCEL_TEAM_SLUG=zach-s-squad

# Optional: a Vercel Deploy Hook URL for the PUBLIC portfolio project (Vercel
# project Settings > Git > Deploy Hooks). When set, saving bio/projects/experience
# in the admin panel rebuilds the prerendered site once edits pause. Treat the URL
# as a secret. Leave unset in local development.
VERCEL_DEPLOY_HOOK_URL=
# Seconds to wait after the last edit before triggering the rebuild (default 60).
REBUILD_DEBOUNCE_SECONDS=60
