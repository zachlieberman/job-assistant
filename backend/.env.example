DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobassistant
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Comma-separated list of allowed frontend origins (CORS).
# In production, set this to your Vercel URL(s), e.g.:
# CORS_ORIGINS=https://job-assistant.vercel.app,https://job-assistant-git-main-yourname.vercel.app
CORS_ORIGINS=http://localhost:5173

# Your Vercel team slug (from a preview URL like
# job-assistant-<hash>-<team-slug>.vercel.app). Every preview deployment
# under this team is allowed via CORS automatically, without needing to add
# CORS_ORIGINS entries by hand after every push.
VERCEL_TEAM_SLUG=zach-s-squad
