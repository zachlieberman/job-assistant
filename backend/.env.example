DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobassistant
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Single-user login for the job tracker and portfolio admin panel.
ADMIN_USERNAME=zachlieberman
ADMIN_PASSWORD=change_me

# Optional: signs login tokens independently of ADMIN_PASSWORD, so rotating
# one doesn't force-invalidate the other's sessions. Falls back to
# ADMIN_PASSWORD if unset.
TOKEN_SIGNING_KEY=

# Comma-separated list of allowed frontend origins (CORS).
# In production, set this to your Vercel URL(s), e.g.:
# CORS_ORIGINS=https://job-assistant.vercel.app,https://job-assistant-git-main-yourname.vercel.app
CORS_ORIGINS=http://localhost:5173
