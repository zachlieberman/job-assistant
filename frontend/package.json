{
  "name": "job-assistant-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:public",
    "build": "npm run build:public",
    "dev:public": "vite --mode public",
    "dev:tracker": "vite --mode tracker",
    "build:public": "vite build --mode public && vite build --mode public --ssr ../../src/entry-server.tsx && node scripts/prerender.mjs",
    "build:tracker": "vite build --mode tracker",
    "preview:public": "vite preview --mode public",
    "preview:tracker": "vite preview --mode tracker",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/familjen-grotesk": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.7.2",
    "d3-sankey": "^0.12.3",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^5.3.2",
    "vitest": "^4.1.9"
  }
}
